# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private source material. The portfolio PDF and the derived outputs for permitted pages are
# committed to the PRIVATE repository so a cloud session can rebuild media. The dissertation
# appendices (physical pages 29-48: ethics forms, consent forms, interview transcripts) are never
# committed: the raw dissertation PDF, its full text, and every appendix page render/image are ignored.
/sources/raw/*Dissertation*.pdf
/sources/derived/text/dissertation.txt
/sources/derived/text/dissertation/page-29.*
/sources/derived/text/dissertation/page-[3-4][0-9].*
/sources/derived/pages/dissertation/page-29.png
/sources/derived/pages/dissertation/page-[3-4][0-9].png
/sources/derived/images/dissertation/p29-*
/sources/derived/images/dissertation/p[3-4][0-9]-*
/sources/derived/contact/dissertation-sheet-*.png
# playwright
/test-results/
/playwright-report/
/docs/evidence/**/*.webm

# local scratch
/.tmp/

# regenerable forensics previews and python caches
/sources/derived/crops-preview/
__pycache__/
